{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NZWalksConnectionString": "REPLACE-IN-ENVIRONMENT-SPECIFIC-CONFIG",
    "NZWalksAuthConnectionString": ""
  },
  "Jwt": {
    "Key": "REPLACE-WITH-A-STRONG-JWT-KEY",
    "Issuer": "https://your-api-host.example.com",
    "Audience": "https://your-api-host.example.com"
  },
  "Swagger": {
    "Enabled": false
  },
  "LoggingTargets": {
    "EnableFile": false
  },
  "Storage": {
    "ImagesFolder": "Images"
  },
  "Deployment": {
    "ApplyMigrationsOnStartup": false
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "Email": "writer@example.com",
    "Password": "CHANGE-ME-WRITER-PASSWORD"
  }
}
